# Copier ce fichier en « .env » pour un usage local (jamais commité), ou définir
# ces variables dans Vercel : Project → Settings → Environment Variables.
# Toutes les valeurs ci-dessous sont fictives.

# Clé API Google Gemini, pour le chatbot (https://aistudio.google.com/apikey)
GEMINI_API_KEY=example-not-a-real-key

# Facultatif : modèle Gemini utilisé (défaut : gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Facultatif : modèle utilisé si le premier est saturé (défaut : gemini-3.1-flash-lite)
GEMINI_MODEL_SECOURS=gemini-3.1-flash-lite

# Clé d'envoi d'un compte Resend gratuit, pour le formulaire de contact (https://resend.com/api-keys)
RESEND_API_KEY=example-not-a-real-key

# Adresse qui reçoit les messages du formulaire (sans domaine vérifié : l'adresse du compte Resend)
CONTACT_DESTINATAIRE=destinataire@example.test

# Facultatif : expéditeur (défaut : Clinique des Pins <onboarding@resend.dev>)
CONTACT_EXPEDITEUR=Clinique des Pins <contact@example.test>
